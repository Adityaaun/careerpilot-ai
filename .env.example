# ==============================================================================
# CareerPilot AI — Environment Configuration Example
# Hidani Tech SDE Intern Assessment
# ==============================================================================

# Persistent PostgreSQL Database Configuration (Required for durable production persistence)
# CareerPilot AI uses PostgreSQL for authoritative application tracking and database-level duplicate prevention.
# Supported providers: Neon Serverless Postgres (Recommended on Vercel), Supabase, AWS RDS, or local PostgreSQL.
# Example for Neon: postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example for Supabase: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# Example for Local: postgresql://postgres:postgres@localhost:5432/careerpilot
# If DATABASE_URL is omitted, CareerPilot AI falls back to local file storage for local development.
DATABASE_URL=

# Disposable PostgreSQL Database for Integration Testing (Optional)
# If provided, `npm run test:integration` will execute real transactional and concurrency tests against this instance.
# If omitted, integration tests are safely and transparently reported as BLOCKED.
TEST_DATABASE_URL=

# LLM Provider Configuration
# CareerPilot AI operates fully with a deterministic rule-based fallback if no LLM key is present.
# To enable live LLM agent orchestration and natural language generation, set one of the following:

# Google Gemini API Key (Recommended)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Optional Alternative)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Preferred LLM Provider ('gemini' | 'openai' | 'deterministic-fallback')
# Default: 'gemini' if GEMINI_API_KEY is present, else 'deterministic-fallback'
AI_PROVIDER=gemini

# Dataset & Storage Configuration
# Path to the normalized 1,500-2,000 real job dataset JSON file
JOBS_DATASET_PATH=./data/jobs.json

# Path to the persisted application records JSON file (used in local development fallback)
APPLICATIONS_STORAGE_PATH=./data/applications.json

# Environment
NODE_ENV=development
